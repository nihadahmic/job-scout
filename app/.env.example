# Copy to .env.local for `npm run dev`. On Vercel, set these in Project Settings -> Environment Variables.
# Both are safe in the browser: row-level security decides what they can read.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (no NEXT_PUBLIC_ prefix, never sent to the browser). Drafting uses these.
GEMINI_API_KEY=
# Optional: a Gemini model to try first (falls back to gemini-3.5-flash-lite when it's busy or slow).
GEMINI_MODEL=
# Optional: lets the Runs page start the collect workflow and show its progress.
# Fine-grained token, this repository only, permission "Actions: read and write".
GITHUB_TOKEN=
# Optional: owner/repo. On Vercel it is read from the connected Git repository.
GITHUB_REPO=
