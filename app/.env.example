# Copy to .env.local for `npm run dev`. On Vercel, set these in Project Settings -> Environment Variables.
# Both are safe in the browser: row-level security decides what they can read.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (no NEXT_PUBLIC_ prefix, never sent to the browser). Drafting uses these.
GEMINI_API_KEY=
# Optional: which Gemini model drafts. Defaults to gemini-3.6-flash.
GEMINI_MODEL=
